APP_NAME=OpenCardHub
APP_ENV=local
APP_URL=http://localhost:3000
APP_PORT=3000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
APP_CORS_ORIGIN=http://localhost:5173,http://localhost:5174
APP_CORS_CREDENTIALS=true
LOGIN_RATE_LIMIT_PER_MINUTE=20
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_MIN_LENGTH=6
PASSWORD_REQUIRE_COMPLEXITY=false
PASSWORD_HASH_ITERATIONS=120000
APPROVAL_ADMIN_PERMISSION_REQUIRED=false
APPROVAL_WITHDRAWAL_PAID_REQUIRED=false
APPROVAL_SETTLEMENT_REVIEW_REQUIRED=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=opencardhub
DB_USERNAME=root
DB_PASSWORD=
DATABASE_URL="mysql://root:@127.0.0.1:3306/opencardhub"

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_VERIFY_CALLBACK_SIGNATURE=false
ALIPAY_MODE=mock
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
