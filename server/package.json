{
  "name": "@opencardhub/server",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "build": "nest build",
    "lint": "eslint \"src/**/*.ts\"",
    "prisma:generate": "node --env-file=../.env ./node_modules/prisma/build/index.js generate",
    "prisma:validate": "node --env-file=../.env ./node_modules/prisma/build/index.js validate",
    "prisma:migrate": "node --env-file=../.env ./node_modules/prisma/build/index.js migrate dev",
    "db:seed": "node --env-file=../.env prisma/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.9",
    "@prisma/client": "6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@nestjs/cli": "^11.0.12",
    "@nestjs/schematics": "^11.0.9",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "prisma": "6.19.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
