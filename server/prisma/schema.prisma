generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserLevelCode {
  V0
  V1
  V2
}

enum UserStatus {
  active
  disabled
}

enum UserRole {
  admin
  agent
  buyer
}

enum SiteStatus {
  pending
  active
  suspended
  expired
  banned
}

enum DomainType {
  main
  system_sub
  custom
}

enum DomainStatus {
  pending
  verified
  active
  failed
  disabled
}

enum ProductType {
  card
  account
  link
  manual
  api
}

enum ProductStatus {
  draft
  active
  hidden
  disabled
}

enum CardStatus {
  unused
  locked
  sold
  invalid
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum DeliveryStatus {
  pending
  delivering
  delivered
  failed
}

enum OrderStatus {
  pending
  paid
  delivering
  completed
  cancelled
  refunded
  failed
}

enum FinanceTransactionType {
  order_profit
  withdrawal_freeze
  withdrawal_paid
  withdrawal_reject
  manual_adjust
}

enum WithdrawalStatus {
  pending
  approved
  rejected
  paid
  cancelled
}

enum SettlementStatus {
  draft
  confirmed
  archived
  voided
}

model User {
  id           BigInt        @id @default(autoincrement())
  username     String        @unique @db.VarChar(64)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  mobile       String?       @unique @db.VarChar(32)
  email        String?       @unique @db.VarChar(128)
  role         UserRole      @default(buyer)
  levelCode    UserLevelCode @default(V0) @map("level_code")
  status       UserStatus    @default(active)
  parentId     BigInt?       @map("parent_id")
  balance      Decimal       @default(0) @db.Decimal(12, 2)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  parent       User?         @relation("UserParent", fields: [parentId], references: [id])
  children     User[]        @relation("UserParent")
  sites        Site[]
  capabilities UserCapability[]
  orders       Order[]       @relation("AgentOrders")
  financeTransactions FinanceTransaction[]
  withdrawals  Withdrawal[]
  settlements  Settlement[]

  @@map("users")
}

model AgentLevel {
  id           BigInt        @id @default(autoincrement())
  code         UserLevelCode @unique
  name         String        @db.VarChar(64)
  description  String?       @db.VarChar(255)
  status       UserStatus    @default(active)
  sortOrder    Int           @default(0) @map("sort_order")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  capabilities LevelCapability[]

  @@map("agent_levels")
}

model LevelCapability {
  id            BigInt     @id @default(autoincrement())
  levelId       BigInt     @map("level_id")
  capabilityKey String     @map("capability_key") @db.VarChar(96)
  enabled       Boolean    @default(false)
  limitValue    Int?       @map("limit_value")
  configJson    Json?      @map("config_json")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  level         AgentLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([levelId, capabilityKey])
  @@map("level_capabilities")
}

model UserCapability {
  id            BigInt   @id @default(autoincrement())
  userId        BigInt   @map("user_id")
  capabilityKey String   @map("capability_key") @db.VarChar(96)
  enabled       Boolean  @default(false)
  limitValue    Int?     @map("limit_value")
  configJson    Json?    @map("config_json")
  expiredAt     DateTime? @map("expired_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, capabilityKey])
  @@map("user_capabilities")
}

model Setting {
  id        BigInt   @id @default(autoincrement())
  scopeType String   @map("scope_type") @db.VarChar(32)
  scopeId   BigInt?  @map("scope_id")
  group     String   @db.VarChar(64)
  key       String   @db.VarChar(96)
  valueJson Json     @map("value_json")
  type      String   @default("json") @db.VarChar(32)
  isPublic  Boolean  @default(false) @map("is_public")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([scopeType, scopeId, group, key])
  @@map("settings")
}

model FeatureFlag {
  id             BigInt  @id @default(autoincrement())
  key            String  @unique @db.VarChar(96)
  name           String  @db.VarChar(96)
  description    String? @db.VarChar(255)
  defaultEnabled Boolean @default(false) @map("default_enabled")
  edition        String  @default("community") @db.VarChar(32)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

model Site {
  id                  BigInt     @id @default(autoincrement())
  ownerUserId          BigInt     @map("owner_user_id")
  name                String     @db.VarChar(96)
  logo                String?    @db.VarChar(512)
  status              SiteStatus @default(pending)
  templateId           BigInt?    @map("template_id")
  themeConfigJson      Json?      @map("theme_config_json")
  seoTitle             String?    @map("seo_title") @db.VarChar(128)
  seoKeywords          String?    @map("seo_keywords") @db.VarChar(255)
  seoDescription       String?    @map("seo_description") @db.VarChar(255)
  notice              String?    @db.Text
  customerServiceJson Json?      @map("customer_service_json")
  expiredAt            DateTime?  @map("expired_at")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  owner               User       @relation(fields: [ownerUserId], references: [id])
  template            Template?  @relation(fields: [templateId], references: [id])
  domains             Domain[]
  siteProducts        SiteProduct[]
  orders              Order[]

  @@index([ownerUserId])
  @@map("sites")
}

model Domain {
  id           BigInt       @id @default(autoincrement())
  siteId       BigInt?      @map("site_id")
  domain       String       @unique @db.VarChar(255)
  type         DomainType
  status       DomainStatus @default(pending)
  verifyToken  String?      @map("verify_token") @db.VarChar(128)
  sslStatus    String?      @map("ssl_status") @db.VarChar(32)
  sslExpiredAt DateTime?    @map("ssl_expired_at")
  isPrimary    Boolean      @default(false) @map("is_primary")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  site         Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([siteId])
  @@map("domains")
}

model Category {
  id        BigInt    @id @default(autoincrement())
  parentId  BigInt?   @map("parent_id")
  name      String    @db.VarChar(96)
  sortOrder Int       @default(0) @map("sort_order")
  status    ProductStatus @default(active)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  parent    Category? @relation("CategoryParent", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryParent")
  products  Product[]

  @@map("categories")
}

model Product {
  id                           BigInt        @id @default(autoincrement())
  categoryId                   BigInt        @map("category_id")
  name                         String        @db.VarChar(128)
  cover                        String?       @db.VarChar(512)
  description                  String?       @db.Text
  productType                  ProductType   @default(card) @map("product_type")
  costPrice                    Decimal       @default(0) @map("cost_price") @db.Decimal(12, 2)
  defaultWholesalePrice        Decimal       @default(0) @map("default_wholesale_price") @db.Decimal(12, 2)
  salePrice                    Decimal       @default(0) @map("sale_price") @db.Decimal(12, 2)
  minSalePrice                 Decimal       @default(0) @map("min_sale_price") @db.Decimal(12, 2)
  stockCount                   Int           @default(0) @map("stock_count")
  allowSiteSale                Boolean       @default(true) @map("allow_site_sale")
  allowAgentEditPrice          Boolean       @default(false) @map("allow_agent_edit_price")
  allowAgentEditName           Boolean       @default(false) @map("allow_agent_edit_name")
  allowAgentEditDescription    Boolean       @default(false) @map("allow_agent_edit_description")
  status                       ProductStatus @default(draft)
  sortOrder                    Int           @default(0) @map("sort_order")
  createdAt                    DateTime      @default(now()) @map("created_at")
  updatedAt                    DateTime      @updatedAt @map("updated_at")

  category                     Category      @relation(fields: [categoryId], references: [id])
  cards                        ProductCard[]
  siteProducts                 SiteProduct[]
  orders                       Order[]

  @@index([categoryId])
  @@map("products")
}

model ProductCard {
  id            BigInt     @id @default(autoincrement())
  productId     BigInt     @map("product_id")
  cardContent   String     @map("card_content") @db.Text
  status        CardStatus @default(unused)
  lockedOrderId BigInt?    @map("locked_order_id")
  soldOrderId   BigInt?    @map("sold_order_id")
  lockedAt      DateTime?  @map("locked_at")
  soldAt        DateTime?  @map("sold_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderCards    OrderCard[]

  @@index([productId, status])
  @@map("product_cards")
}

model SiteProduct {
  id                BigInt   @id @default(autoincrement())
  siteId            BigInt   @map("site_id")
  productId         BigInt   @map("product_id")
  customName        String?  @map("custom_name") @db.VarChar(128)
  customDescription String?  @map("custom_description") @db.Text
  customCover       String?  @map("custom_cover") @db.VarChar(512)
  customPrice       Decimal? @map("custom_price") @db.Decimal(12, 2)
  isVisible         Boolean  @default(true) @map("is_visible")
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  site              Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([siteId, productId])
  @@map("site_products")
}

model PricingRule {
  id             BigInt   @id @default(autoincrement())
  scopeType      String   @map("scope_type") @db.VarChar(32)
  scopeId        BigInt?  @map("scope_id")
  ruleType       String   @map("rule_type") @db.VarChar(64)
  priority       Int      @default(0)
  conditionsJson Json?    @map("conditions_json")
  actionsJson    Json     @map("actions_json")
  status         String   @default("active") @db.VarChar(32)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([scopeType, scopeId, priority])
  @@map("pricing_rules")
}

model Order {
  id             BigInt         @id @default(autoincrement())
  orderNo        String         @unique @map("order_no") @db.VarChar(64)
  siteId         BigInt?        @map("site_id")
  agentUserId    BigInt?        @map("agent_user_id")
  buyerContact   String?        @map("buyer_contact") @db.VarChar(128)
  productId      BigInt         @map("product_id")
  quantity       Int            @default(1)
  unitPrice      Decimal        @map("unit_price") @db.Decimal(12, 2)
  totalAmount    Decimal        @map("total_amount") @db.Decimal(12, 2)
  costAmount     Decimal        @default(0) @map("cost_amount") @db.Decimal(12, 2)
  agentProfit    Decimal        @default(0) @map("agent_profit") @db.Decimal(12, 2)
  platformProfit Decimal        @default(0) @map("platform_profit") @db.Decimal(12, 2)
  paymentMethod  String?        @map("payment_method") @db.VarChar(64)
  paymentStatus  PaymentStatus  @default(pending) @map("payment_status")
  deliveryStatus DeliveryStatus @default(pending) @map("delivery_status")
  orderStatus    OrderStatus    @default(pending) @map("order_status")
  clientIp       String?        @map("client_ip") @db.VarChar(64)
  paidAt         DateTime?      @map("paid_at")
  deliveredAt    DateTime?      @map("delivered_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  site           Site?          @relation(fields: [siteId], references: [id], onDelete: SetNull)
  agent          User?          @relation("AgentOrders", fields: [agentUserId], references: [id], onDelete: SetNull)
  product        Product        @relation(fields: [productId], references: [id])
  orderCards     OrderCard[]
  payments       Payment[]

  @@index([siteId])
  @@index([agentUserId])
  @@index([productId])
  @@map("orders")
}

model OrderCard {
  id                  BigInt      @id @default(autoincrement())
  orderId             BigInt      @map("order_id")
  productCardId       BigInt      @map("product_card_id")
  cardContentSnapshot String      @map("card_content_snapshot") @db.Text
  createdAt           DateTime    @default(now()) @map("created_at")

  order               Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productCard         ProductCard @relation(fields: [productCardId], references: [id])

  @@unique([orderId, productCardId])
  @@map("order_cards")
}

model Payment {
  id            BigInt        @id @default(autoincrement())
  orderId       BigInt        @map("order_id")
  paymentNo     String        @unique @map("payment_no") @db.VarChar(96)
  provider      String        @db.VarChar(64)
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(pending)
  rawNotifyJson Json?         @map("raw_notify_json")
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments")
}

model FinanceTransaction {
  id           BigInt                 @id @default(autoincrement())
  userId       BigInt                 @map("user_id")
  type         FinanceTransactionType
  amount       Decimal                @db.Decimal(12, 2)
  balanceAfter Decimal                @map("balance_after") @db.Decimal(12, 2)
  referenceNo  String                 @unique @map("reference_no") @db.VarChar(128)
  remark       String?                @db.VarChar(255)
  metadataJson Json?                  @map("metadata_json")
  createdAt    DateTime               @default(now()) @map("created_at")

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("finance_transactions")
}

model Withdrawal {
  id           BigInt           @id @default(autoincrement())
  userId       BigInt           @map("user_id")
  amount       Decimal          @db.Decimal(12, 2)
  status       WithdrawalStatus @default(pending)
  accountType  String           @map("account_type") @db.VarChar(32)
  accountName  String           @map("account_name") @db.VarChar(96)
  accountNo    String           @map("account_no") @db.VarChar(128)
  remark       String?          @db.VarChar(255)
  reviewRemark String?          @map("review_remark") @db.VarChar(255)
  reviewedAt   DateTime?        @map("reviewed_at")
  paidAt       DateTime?        @map("paid_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("withdrawals")
}

model Settlement {
  id                BigInt           @id @default(autoincrement())
  settlementNo      String           @unique @map("settlement_no") @db.VarChar(64)
  settlementScope   String           @map("settlement_scope") @db.VarChar(64)
  userId            BigInt?          @map("user_id")
  status            SettlementStatus @default(draft)
  periodStart       DateTime         @map("period_start")
  periodEnd         DateTime         @map("period_end")
  paidOrderCount    Int              @default(0) @map("paid_order_count")
  paidAmount        Decimal          @default(0) @map("paid_amount") @db.Decimal(12, 2)
  costAmount        Decimal          @default(0) @map("cost_amount") @db.Decimal(12, 2)
  agentProfit       Decimal          @default(0) @map("agent_profit") @db.Decimal(12, 2)
  platformProfit    Decimal          @default(0) @map("platform_profit") @db.Decimal(12, 2)
  withdrawalAmount  Decimal          @default(0) @map("withdrawal_amount") @db.Decimal(12, 2)
  snapshotJson      Json             @map("snapshot_json")
  remark            String?          @db.VarChar(255)
  confirmedAt       DateTime?        @map("confirmed_at")
  voidedAt          DateTime?        @map("voided_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  user              User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([settlementScope, periodStart, periodEnd, status])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@map("settlements")
}

model Template {
  id                BigInt   @id @default(autoincrement())
  name              String   @db.VarChar(96)
  key               String   @unique @db.VarChar(96)
  previewImage      String?  @map("preview_image") @db.VarChar(512)
  configSchemaJson  Json?    @map("config_schema_json")
  defaultConfigJson Json?    @map("default_config_json")
  isPremium         Boolean  @default(false) @map("is_premium")
  status            String   @default("active") @db.VarChar(32)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  sites             Site[]

  @@map("templates")
}

model NotificationTemplate {
  id              BigInt   @id @default(autoincrement())
  eventKey        String   @map("event_key") @db.VarChar(96)
  channel         String   @db.VarChar(64)
  titleTemplate   String   @map("title_template") @db.VarChar(255)
  contentTemplate String   @map("content_template") @db.Text
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([eventKey, channel])
  @@map("notification_templates")
}

model OperationLog {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt?  @map("user_id")
  action     String   @db.VarChar(96)
  targetType String?  @map("target_type") @db.VarChar(64)
  targetId   BigInt?  @map("target_id")
  ip         String?  @db.VarChar(64)
  detailJson Json?    @map("detail_json")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([targetType, targetId])
  @@map("operation_logs")
}
